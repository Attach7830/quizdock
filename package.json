{
  "name": "quizdock-classroom-arcade",
  "version": "0.4.0-classroom-beta",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "test": "node --import ./test/register.mjs --test test/*.test.js",
    "check": "node tools/check-syntax.mjs",
    "test:browser": "python tools/run-browser-tests.py",
    "health": "node tools/healthcheck.mjs",
    "verify": "npm run check && npm test"
  },
  "devDependencies": {
    "wrangler": "^4.45.0"
  }
}
