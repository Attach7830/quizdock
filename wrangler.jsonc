{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quizdock",
  "keep_vars": true,
  "main": "src/library-worker.js",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "QuizRoom"
      },
      {
        "name": "TEACHER_LIBRARY",
        "class_name": "TeacherLibrary"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "QuizRoom"
      ]
    },
    {
      "tag": "v2-teacher-library",
      "new_sqlite_classes": [
        "TeacherLibrary"
      ]
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "GOOGLE_CLIENT_ID": "544077726024-gnbg8fehleu46g18runac2tiddtdrckp.apps.googleusercontent.com"
  }
}
